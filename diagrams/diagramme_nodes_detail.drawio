        <mxCell id="n3_zone" value="&lt;b&gt;③ diagnostic_node&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="60" width="360" height="340" as="geometry"/>
        </mxCell>

