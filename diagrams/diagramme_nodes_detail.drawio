          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="n2_routes" value="&lt;b&gt;Routes sortantes&lt;/b&gt;&lt;br&gt;• evaluation_score/feynman_score → evaluate&lt;br&gt;• quiz_active sans score → method&lt;br&gt;• awaiting sans explanation → method&lt;br&gt;• sinon → retrieve" style="text;html=1;align=left;fontSize=9;fontColor=#2e7d32;" vertex="1" parent="n2_zone">
          <mxGeometry x="30" y="480" width="320" height="45" as="geometry"/>
