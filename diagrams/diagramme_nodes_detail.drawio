        </mxCell>

        <mxCell id="n1_meta" value="&lt;b&gt;_is_meta_question(question)&lt;/b&gt;&lt;br&gt;6 regex patterns :&lt;br&gt;• ^(salut|bonjour|hello|...) → salutation&lt;br&gt;• ^(merci|ok|bien|...) → accusé réception&lt;br&gt;• ^(qui es-tu|quel est ton...) → méta&lt;br&gt;• ^(oui|non|peut-être) → réponse vague&lt;br&gt;&lt;br&gt;+ heuristic : &amp;lt;4 mots sans hints pédagogiques" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n1_zone">
