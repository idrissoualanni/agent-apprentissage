          <mxGeometry x="50" y="35" width="260" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="n3_prompt" value="&lt;b&gt;DIAGNOSTIC_PROMPT&lt;/b&gt;&lt;br&gt;domain = profile['domain']&lt;br&gt;Génère 3 questions calibrées&lt;br&gt;Format JSON: {questions: [...], estimated_level}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="n3_zone">
          <mxGeometry x="50" y="80" width="260" height="55" as="geometry"/>
        </mxCell>
