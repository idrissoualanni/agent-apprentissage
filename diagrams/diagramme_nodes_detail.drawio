          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="n6_false" value="False → method='scaffold'&lt;br&gt;'Pas de souci, on fait autre chose!'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=9;" vertex="1" parent="n6_zone">
          <mxGeometry x="260" y="165" width="80" height="40" as="geometry"/>
        </mxCell>
