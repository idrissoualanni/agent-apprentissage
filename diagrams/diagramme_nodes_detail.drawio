        </mxCell>

        <mxCell id="n9_resolve" value="&lt;b&gt;_resolve_competency_id()&lt;/b&gt;&lt;br&gt;1. crud.get_competencies(domain)&lt;br&gt;2. Matching nom == competency_name&lt;br&gt;3. → competency_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n9_zone">
          <mxGeometry x="100" y="210" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n9_session" value="&lt;b&gt;_resolve_session_id()&lt;/b&gt;&lt;br&gt;1. SELECT id FROM session WHERE langgraph_thread_id=?&lt;br&gt;2. Fallback: ORDER BY started_at DESC LIMIT 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n9_zone">
          <mxGeometry x="80" y="280" width="220" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="n9_return" value="&lt;b&gt;Return {leitner_action, evaluation_score/feynman_score}&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="n9_zone">
