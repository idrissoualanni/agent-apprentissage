          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="n3_return" value="&lt;b&gt;Return&lt;/b&gt;&lt;br&gt;{diagnostic_questions, estimated_level, method='diagnostic', answer=response.content}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="n3_zone">
          <mxGeometry x="50" y="285" width="260" height="35" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- NODE 4: retrieval -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="n4_zone" value="&lt;b&gt;④ retrieval_node&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
