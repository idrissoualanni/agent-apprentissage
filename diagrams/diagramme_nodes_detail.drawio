          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="n3_parse" value="&lt;b&gt;Parse réponse&lt;/b&gt;&lt;br&gt;1. Strip ```json ... ```&lt;br&gt;2. json.loads() → {questions, estimated_level}&lt;br&gt;3. Fallback si JSONDecodeError" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="n3_zone">
          <mxGeometry x="50" y="150" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="en3_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="n3_prompt" target="n3_parse" parent="n3_zone">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="n3_mastery" value="&lt;b&gt;Init mastery pour chaque compétence&lt;/b&gt;&lt;br&gt;level_to_score: {debutant: 0.2, inter: 0.5, avance: 0.8}&lt;br&gt;Pour chaque comp: crud.upsert_mastery(score, box=0, status='new')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n3_zone">
          <mxGeometry x="30" y="220" width="300" height="50" as="geometry"/>
        </mxCell>
