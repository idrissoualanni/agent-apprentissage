          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- NODE 5: method_selection -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="n5_zone" value="&lt;b&gt;⑤ method_selection_node&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#e8eaf6;strokeColor=#283593;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="60" width="380" height="520" as="geometry"/>
        </mxCell>

        <mxCell id="n5_detect_comp" value="&lt;b&gt;_detect_active_competency()&lt;/b&gt;&lt;br&gt;1. crud.get_competencies(domain)&lt;br&gt;2. Pour chaque comp : score matching&lt;br&gt;   • nom dans question → +10 pts&lt;br&gt;   • mots nom (&gt;3 chars) dans question → +2 pts&lt;br&gt;   • mots description (&gt;4 chars) → +1 pt&lt;br&gt;3. best_score ≥ 2 → retourne comp名称" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n5_zone">
          <mxGeometry x="30" y="35" width="320" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="n5_decisions" value="&lt;b&gt;Cascade de décision&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. quiz_active → method='quiz'&lt;br&gt;2. feynman_explanation → method='feynman'&lt;br&gt;3. _needs_revision() → method='revision'&lt;br&gt;4. _needs_web_search() → method='web_search'&lt;br&gt;5. level=='debutant' → method='scaffold'&lt;br&gt;6. level=='intermediaire' → method='socratic'&lt;br&gt;7. Sinon (avancé) → method='feynman'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n5_zone">
          <mxGeometry x="30" y="160" width="320" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="n5_needs_rev" value="&lt;b&gt;_needs_revision()&lt;/b&gt;&lt;br&gt;Patterns: révis|revision|rappel|revoir&lt;br&gt;|rattrap|exercice.*révis|carte.*mémoire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n5_zone">
          <mxGeometry x="30" y="315" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="n5_needs_web" value="&lt;b&gt;_needs_web_search()&lt;/b&gt;&lt;br&gt;Patterns: prix|cours|taux|dernier|nouveau&lt;br&gt;|actualité|combien coûte|crypto|météo|score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n5_zone">
          <mxGeometry x="30" y="380" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="n5_return" value="&lt;b&gt;Return {method, active_competency}&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="n5_zone">
          <mxGeometry x="70" y="450" width="240" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="n5_routes" value="&lt;b&gt;Routes&lt;/b&gt;&lt;br&gt;quiz/feynman/artifact → confirmation&lt;br&gt;web_search/revision → tool&lt;br&gt;scaffold/socratic/diagnostic → generate" style="text;html=1;align=left;fontSize=9;fontColor=#283593;" vertex="1" parent="n5_zone">
          <mxGeometry x="30" y="490" width="320" height="30" as="geometry"/>
        </mxCell>

