        </mxCell>

        <mxCell id="n7_llm" value="&lt;b&gt;llm = model_manager.get_llm('answer')&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="n7_zone">
          <mxGeometry x="70" y="100" width="240" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="n7_select_prompt" value="&lt;b&gt;Sélection prompt selon method&lt;/b&gt;&lt;br&gt;• socratic → SOCRATIC_PROMPT (questions only)&lt;br&gt;• feynman → FEYNMAN_PROMPT_NODE (invite explanation)&lt;br&gt;• scaffold → SCAFFOLD_PROMPT (définition+analogie+exemple)&lt;br&gt;• diagnostic → DIAGNOSTIC_PROMPT (3 questions level)&lt;br&gt;• autre → RESPONSE_PROMPT (réponse directe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n7_zone">
          <mxGeometry x="30" y="145" width="320" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="en7_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="n7_llm" target="n7_select_prompt" parent="n7_zone">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="n7_format" value="&lt;b&gt;format_messages()&lt;/b&gt;&lt;br&gt;context, competency_name, level, method, chat_history, question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="n7_zone">
          <mxGeometry x="50" y="245" width="280" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="n7_return" value="&lt;b&gt;response = llm.invoke(messages)&lt;/b&gt;&lt;br&gt;→ return {answer: response.content}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="n7_zone">
          <mxGeometry x="50" y="290" width="280" height="35" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- NODE 8: tool_execution -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="n8_zone" value="&lt;b&gt;⑧ tool_execution_node&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#fff8e1;strokeColor=#f57f17;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="610" width="380" height="340" as="geometry"/>
        </mxCell>

        <mxCell id="n8_timer" value="&lt;b&gt;t0 = time.time()&lt;/b&gt; (mesure durée)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="n8_zone">
          <mxGeometry x="100" y="35" width="180" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="n8_switch" value="&lt;b&gt;tool = state['method']&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="n8_zone">
          <mxGeometry x="120" y="70" width="140" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="n8_quiz" value="&lt;b&gt;quiz&lt;/b&gt;&lt;br&gt;generate_quiz.invoke()&lt;br&gt;→ quiz_questions, quiz_active=True&lt;br&gt;→ _format_quiz_for_display()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="n8_zone">
          <mxGeometry x="10" y="140" width="110" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="n8_feynman" value="&lt;b&gt;feynman&lt;/b&gt;&lt;br&gt;Si explanation : evaluate_feynman()&lt;br&gt;→ feynman_score, gaps, feedback&lt;br&gt;Sinon : demande explanation&lt;br&gt;→ awaiting=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="n8_zone">
          <mxGeometry x="130" y="140" width="120" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="n8_web" value="&lt;b&gt;web_search&lt;/b&gt;&lt;br&gt;web_search.invoke(query, 3)&lt;br&gt;→ [{title, url, snippet}]&lt;br&gt;→ Formatage Markdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="n8_zone">
          <mxGeometry x="260" y="140" width="110" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="n8_revision" value="&lt;b&gt;revision&lt;/b&gt;&lt;br&gt;get_revision_plan.invoke(domain)&lt;br&gt;→ plan[] + total_due&lt;br&gt;→ Formatage liste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="n8_zone">
          <mxGeometry x="10" y="220" width="110" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n8_artifact" value="&lt;b&gt;artifact&lt;/b&gt;&lt;br&gt;create_artifact.invoke()&lt;br&gt;→ {type, title, content}&lt;br&gt;→ artifacts.append(record)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="n8_zone">
          <mxGeometry x="130" y="225" width="120" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="n8_transparency" value="&lt;b&gt;_track_tool()&lt;/b&gt;&lt;br&gt;elapsed = (time.time()-t0)*1000&lt;br&gt;tool_transparency.append({name, duration_ms, success})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n8_zone">
          <mxGeometry x="260" y="225" width="110" height="55" as="geometry"/>
