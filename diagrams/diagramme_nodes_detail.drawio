          <mxGeometry x="30" y="610" width="360" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="n6_prompts" value="&lt;b&gt;CONFIRMATION_METHODS&lt;/b&gt;&lt;br&gt;quiz: 'Je vais te préparer un quiz...('&lt;br&gt;feynman: 'On va tester avec Feynman...('&lt;br&gt;artifact: 'Je vais créer un artefact...('" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n6_zone">
          <mxGeometry x="20" y="35" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="n6_dec" value="&lt;b&gt;user_confirmed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="n6_zone">
          <mxGeometry x="130" y="120" width="110" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="n6_none" value="pending_confirmation=True&lt;br&gt;→ Envoie boutons UI&lt;br&gt;→ Fin de cycle (attend choix)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n6_zone">
          <mxGeometry x="20" y="190" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="en6_1" value="None" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;" edge="1" source="n6_dec" target="n6_none" parent="n6_zone">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="n6_true" value="True → pending=False&lt;br&gt;→ tool_execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="n6_zone">
          <mxGeometry x="260" y="120" width="80" height="35" as="geometry"/>
