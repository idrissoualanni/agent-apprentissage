        <!-- NODE 7: generate -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="n7_zone" value="&lt;b&gt;⑦ generate_node&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#e0f7fa;strokeColor=#00695c;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="610" width="380" height="340" as="geometry"/>
        </mxCell>

        <mxCell id="n7_skip" value="&lt;b&gt;Skip si&lt;/b&gt;&lt;br&gt;answer existe déjà &amp;amp;&amp;amp; method ∈ (quiz, feynman, artifact, web_search, revision)&lt;br&gt;→ return {} (pas de double génération)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=9;" vertex="1" parent="n7_zone">
