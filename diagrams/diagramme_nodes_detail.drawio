        <mxCell id="n4_retrieve" value="&lt;b&gt;docs = retriever.invoke(question)&lt;/b&gt;&lt;br&gt;ChromaDB similarity_search(k=3)&lt;br&gt;→ top-3 documents les plus proches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="n4_zone">
          <mxGeometry x="30" y="35" width="300" height="50" as="geometry"/>
        </mxCell>

