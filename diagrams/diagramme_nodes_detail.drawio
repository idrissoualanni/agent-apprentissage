        </mxCell>

        <mxCell id="n9_quiz" value="&lt;b&gt;evaluation_score?&lt;/b&gt;&lt;br&gt;1. _resolve_competency_id()&lt;br&gt;2. update_mastery_after_quiz()&lt;br&gt;3. record_quiz_attempt()&lt;br&gt;4. leitner_action = promote/demote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="n9_zone">
