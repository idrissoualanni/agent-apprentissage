        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FORMAT PARSERS (droite) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <mxCell id="zone_parsers" value="&lt;b&gt;🔧 PARSERS DE SORTIE&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="330" width="510" height="620" as="geometry"/>
        </mxCell>

        <mxCell id="parser_invoke" value="&lt;b&gt;FormatControlledLLM.invoke(messages)&lt;/b&gt;&lt;br&gt;response = llm.invoke(messages)&lt;br&gt;raw = getattr(response, 'content', str(response))&lt;br&gt;parsed = parser.parse(raw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="zone_parsers">
          <mxGeometry x="60" y="40" width="390" height="60" as="geometry"/>
        </mxCell>

        <!-- StrictJSON -->
        <mxCell id="parser_sj" value="&lt;b&gt;StrictJSONParser&lt;/b&gt;&lt;br&gt;format_mode = 'strict_json'&lt;br&gt;&lt;br&gt;1. Strip ```json ... ```&lt;br&gt;2. json.loads(content)&lt;br&gt;3. Si échec → ValueError&lt;br&gt;&lt;br&gt;→ {type: 'json', data: {...}}&lt;br&gt;→ Utilisé par: quiz_generation, relevance_check, artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4f8;strokeColor=#4a90d9;fontSize=10;" vertex="1" parent="zone_parsers">
          <mxGeometry x="20" y="120" width="230" height="140" as="geometry"/>
        </mxCell>

        <!-- HybridParser -->
        <mxCell id="parser_hybrid" value="&lt;b&gt;HybridParser&lt;/b&gt;&lt;br&gt;format_mode = 'json_or_markdown'&lt;br&gt;&lt;br&gt;1. Tente StrictJSONParser.parse()&lt;br&gt;2. Si ValueError → fallback&lt;br&gt;3. Retourne markdown brut&lt;br&gt;&lt;br&gt;→ {type: 'json'|'markdown', data: ...}&lt;br&gt;→ Utilisé par: chat, feynman_eval, summarize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3e2;strokeColor=#d4a04a;fontSize=10;" vertex="1" parent="zone_parsers">
          <mxGeometry x="260" y="120" width="230" height="140" as="geometry"/>
        </mxCell>

        <!-- MarkdownParser -->
        <mxCell id="parser_md" value="&lt;b&gt;MarkdownParser&lt;/b&gt;&lt;br&gt;format_mode = 'markdown'&lt;br&gt;&lt;br&gt;→ Tout passe en brut&lt;br&gt;→ {type: 'markdown', data: content}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="zone_parsers">
          <mxGeometry x="20" y="280" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- FreeTextParser -->
        <mxCell id="parser_ft" value="&lt;b&gt;FreeTextParser&lt;/b&gt;&lt;br&gt;format_mode = 'free_text'&lt;br&gt;&lt;br&gt;→ Pas de parsing&lt;br&gt;→ {type: 'text', data: content}&lt;br&gt;→ Utilisé par: embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="zone_parsers">
          <mxGeometry x="260" y="280" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- ParsedResponse -->
        <mxCell id="parser_response" value="&lt;b&gt;ParsedResponse&lt;/b&gt;&lt;br&gt;.raw → texte brut du LLM&lt;br&gt;.parsed → dict {type, data}&lt;br&gt;.content → string (JSON ou markdown)&lt;br&gt;&lt;br&gt;Compat LangChain: .content utilisé par les nœuds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="zone_parsers">
          <mxGeometry x="100" y="380" width="310" height="80" as="geometry"/>
        </mxCell>

