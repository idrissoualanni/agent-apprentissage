        <mxCell id="flow_return" value="&lt;b&gt;return FormatControlledLLM&lt;/b&gt;&lt;br&gt;→ .invoke(messages) → ParsedResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="zone_flow">
