        </mxCell>
        <mxCell id="flow_local_make" value="&lt;b&gt;ChatOllama&lt;/b&gt;&lt;br&gt;model=name, temperature=temp&lt;br&gt;num_gpu=OLLAMA_NUM_GPU&lt;br&gt;&lt;br&gt;→ Appel local Ollama serve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="zone_flow">
