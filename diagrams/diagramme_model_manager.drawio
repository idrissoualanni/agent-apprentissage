        <mxCell id="fallback_chain" value="minimax-m3 → qwen3.5:397b → kimi-k2.7-code → qwen2.5:1.5b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="zone_parsers">
