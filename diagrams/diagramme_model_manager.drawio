        <mxCell id="fallback_note" value="model_manager.fallback(failed_model) → retourne le modèle suivant&lt;br&gt;Utilisé en cas d'erreur 401, timeout, etc." style="text;html=1;fontSize=10;fontColor=#666666;" vertex="1" parent="zone_parsers">
          <mxGeometry x="20" y="555" width="400" height="30" as="geometry"/>
