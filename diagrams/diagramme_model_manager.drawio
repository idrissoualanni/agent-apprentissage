        <mxCell id="refresh_note" value="Appelle ollama.Client.list() → détecte les modèles disponibles&lt;br&gt;Ajoute les modèles inconnus au catalogue automatiquement&lt;br&gt;Retourne {added: N, total: M}" style="text;html=1;fontSize=10;fontColor=#666666;" vertex="1" parent="zone_parsers">
