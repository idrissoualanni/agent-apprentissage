# ═══════════════════════════════════════════════════════════════════════
#  Agent d'Apprentissage — Variables d'environnement
#  Copier ce fichier en `.env` et remplir les valeurs.
#  ⚠️ Ne JAMAIS committer `.env` (il est dans .gitignore).
# ═══════════════════════════════════════════════════════════════════════

# ─── Ollama Cloud (REQUIS — tous les LLMs sont cloud) ────────────────────
# URL du serveur Ollama Cloud.
OLLAMA_BASE_URL=https://ollama.com
# Cle API Ollama Cloud. REQUIS pour les LLMs cloud.
OLLAMA_API_KEY=

# ─── Modeles ──────────────────────────────────────────────────────────────
# Modele de generation par defaut (cloud).
OLLAMA_MODEL=minimax-m3
# Liste des modeles affichables dans le selecteur (cloud uniquement).
AVAILABLE_MODELS=minimax-m3,qwen3.5:397b,kimi-k2.7-code,deepseek-v4-flash:preview,gpt-oss:120b
# Modele d'embedding RAG. NB: reste local pour l'instant (necessite `ollama serve`).
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Nombre de GPU pour Ollama local (0 = CPU).
OLLAMA_NUM_GPU=0

# ─── RAG (Chunking + retrieval) ───────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3

# ─── RAG semantique (double-check pertinence) ─────────────────────────────
# Seuil de similarite min pour considerer un chunk pertinent.
RAG_SEMANTIC_THRESHOLD=0.3
# Confiance min pour utiliser le contexte RAG.
RAG_MIN_CONFIDENCE=0.6
# Activer le double-check de pertinence RAG.
RAG_DOUBLE_CHECK_ENABLED=true

# ─── Web search (optionnel) ───────────────────────────────────────────────
# Provider par defaut : ddgs (DuckDuckGo, sans cle) | tavily | brave.
WEB_SEARCH_DEFAULT_PROVIDER=ddgs
# Cle API Tavily (optionnel, si provider=tavily).
TAVILY_API_KEY=
# Cle API Brave Search (optionnel, si provider=brave).
BRAVE_API_KEY=
# Duree du cache de recherche web (heures).
WEB_SEARCH_CACHE_TTL_HOURS=24
