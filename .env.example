# ─── Modeles ──────────────────────────────────────────────────────────────
# Liste des modeles affichables dans le selecteur Streamlit (separes par virgule)
AVAILABLE_MODELS=qwen2.5:1.5b,qwen2.5-coder:3b
# Modele utilise par defaut pour la generation
OLLAMA_MODEL=qwen2.5:1.5b
# Modele utilise pour les embeddings (doit etre tire cote Ollama)
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# ─── Ollama (distant ou local) ────────────────────────────────────────────
# Laisser vide pour localhost:11434, ou mettre l'URL du serveur distant
# Exemple : OLLAMA_BASE_URL=https://api.example.com
OLLAMA_BASE_URL=
# Clé API Ollama (uniquement si serveur distant avec auth).
# Ne JAMAIS committer une vraie cle ; copier ce fichier en .env et la remplir.
OLLAMA_API_KEY=

# ─── Parametres RAG ───────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3
